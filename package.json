{
  "name": "sparkfleet",
  "version": "1.0.0",
  "description": "Localhost dashboard and control plane for one to eight NVIDIA DGX Spark nodes",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun run build && bun server/index.ts",
    "demo": "bun run build && PATH=\"$PWD/demo/bin:$PATH\" SPARKFLEET_CONFIG=demo/fleet.json bun --preload ./demo/preload.ts server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.2.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
